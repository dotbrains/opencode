{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/kimi-k2.5",
  "autoupdate": true,
  "provider": {
    "anthropic": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "agent": {
    "compaction": {
      "model": "anthropic/claude-haiku-4-5"
    }
  },
  "mcp": {
    "context-mode": {
      "type": "local",
      "command": ["context-mode"]
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    }
  },
  "plugin": ["context-mode"],
  "instructions": ["rules/no-coauthor.md", "rules/cli-projects.md"]
}
