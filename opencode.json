{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/qwen3.6-plus",
  "default_agent": "orchestrator",
  "autoupdate": true,
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "provider": {
    "anthropic": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 40000
  },
  "agent": {
    "compaction": {
      "model": "opencode-go/qwen3.6-plus"
    }
  },
  "mcp": {
    "context-mode": {
      "type": "local",
      "command": ["context-mode"]
    }
  },
  "plugin": ["context-mode", "superpowers@git+https://github.com/obra/superpowers.git", "@warp-dot-dev/opencode-warp", "opencode-swarm"],
  "instructions": ["rules/no-coauthor.md", "rules/cli-projects.md", "rules/concise.md"]
}
