{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/minimax-m2.5-free",
  "default_agent": "orchestrator",
  "autoupdate": true,
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "provider": {
    "anthropic": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 25000
  },
  "agent": {
    "compaction": {
      "model": "google/gemini-2.5-pro"
    }
  },
  "mcp": {
    "context-mode": {
      "type": "local",
      "command": ["context-mode"]
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    }
  },
  "plugin": ["context-mode", "superpowers@git+https://github.com/obra/superpowers.git"],
  "instructions": ["rules/no-coauthor.md", "rules/cli-projects.md"]
}
